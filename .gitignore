# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (sdk path, etc)
local.properties

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio
#
# The whole directory, rather than the file-by-file list this used to carry.
# That list was the old project template and it had already fallen behind what
# Studio writes - .name, AndroidProjectSystem.xml, codeStyles/, misc.xml,
# runConfigurations.xml and studiobot.xml all escaped it - so `.idea` kept
# reappearing as untracked. Enumerating them again only defers the same problem
# to the next Studio release.
#
# Nothing in here is shared. If the project ever wants a common code style,
# un-ignore .idea/codeStyles/ specifically rather than reopening the list.
*.iml
.idea/

# Keystore files
*.jks
*.keystore

# OS-specific files
.DS_Store
Thumbs.db

# External native build
.externalNativeBuild
.cxx

# Kotlin
.kotlin/

# Python bytecode from tools/
__pycache__/
*.pyc
