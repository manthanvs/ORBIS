<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Special permission: it cannot be requested at runtime. The user grants it
        from Settings, which UsageAccess.settingsIntent() deep-links to.
        tools:ignore is required because lint rejects protected system permissions.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Required by the VPN relay, despite the "no server component" design.
        Intercepting other apps' traffic needs no permission, but *forwarding* it
        does: the relay opens its own sockets, and without INTERNET every
        DatagramSocket() throws EPERM and the tunnel silently blackholes
        everything it captures.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        The tunnel must survive ORBIS being backgrounded - which is precisely when
        the user is scrolling Reels. Without a foreground service Android may kill
        it mid-session and the throttle silently stops working.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Package visibility for VariantDiscovery. Android 11+ hides other apps
        from queryIntentActivities unless they are queried for here, so without
        this no build of Instagram, YouTube or Snapchat - official or modded -
        could ever be found, and ORBIS would be stuck with a hardcoded list.

        Scoped to the three sites whose apps ORBIS targets: this grants no
        visibility of anything else on the phone. Discovery then keeps only
        packages that also carry the app's own view ids.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="www.instagram.com" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="www.youtube.com" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="www.snapchat.com" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ORBISOptimizedResponsibleBrowsingInterventionSystem">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ORBISOptimizedResponsibleBrowsingInterventionSystem"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Detection only (Phase 2a) - this service throttles nothing.
            The BIND_ACCESSIBILITY_SERVICE permission means only the system can
            bind it, and accessibility_service_config.xml restricts which apps it
            may observe at all.
        -->
        <service
            android:name=".surface.OrbisAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            The tunnel is restricted to the three target apps via
            addAllowedApplication and is only established while a short-form
            video surface is on screen. BIND_VPN_SERVICE means only the system
            can bind it. Consent still comes from the system dialog raised by
            VpnService.prepare().
        -->
        <service
            android:name=".vpn.OrbisVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Slows short-form video traffic while the user is viewing it" />
        </service>
    </application>

</manifest>