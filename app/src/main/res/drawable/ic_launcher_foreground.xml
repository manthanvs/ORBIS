<!--
    The ORBIS mark: a body held on a steady orbit around a centre.

    Literal to the name (orbis = orb, circle) and deliberately not a barrier, a
    cross or a bar - ORBIS adds friction to short-form video, it does not block
    it, and the icon is the first thing that says so.

    The ring is deliberately flat - 27:9.5, near 3:1 - and the orb is wider than
    the ring's semi-minor axis, so the orb hides the near and far sides of the
    path and only the two wings show. Both choices exist to kill an "eye"
    reading: an ellipse of roughly 2:1 around a centred disc is a pupil in a lid,
    and an eye is the worst possible mark for an app whose AccessibilityService
    reads the screen. It has to look like a planet, not a watcher.

    Geometry is pinned to the adaptive-icon safe zone. The 108dp viewport is
    masked by the launcher down to a guaranteed-visible circle of 66dp, i.e.
    radius 33 from the centre at (54,54). The furthest point of this mark is the
    orbiting body at 27 + 5 = 32. Anything past 33 gets clipped on some launchers
    and not others, which is how icons end up looking broken on one phone and
    fine on another.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="orbit"
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-28">

        <!-- Orbit path. Drawn first so the orb occludes it. -->
        <path
            android:pathData="M27,54 a27,9.5 0 1,0 54,0 a27,9.5 0 1,0 -54,0"
            android:strokeColor="#FF3FBFA9"
            android:strokeWidth="5"
            android:strokeLineCap="round" />

        <!-- The orbiting body, centred on the path. The one warm accent, and the
             same amber the good-deed streak uses. -->
        <path
            android:pathData="M76,54 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
            android:fillColor="#FFF2BF48" />
    </group>

    <!-- The centre orb sits outside the rotated group: it is on the axis, so
         rotating it would only cost a transform for no visible change. -->
    <path
        android:pathData="M44,54 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0"
        android:fillColor="#FF7DF0DD" />
</vector>
