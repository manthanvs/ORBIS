<!--
    Adaptive-icon background: a deep teal field.

    A diagonal gradient rather than a flat fill, so the tile still has some depth
    once a launcher masks it into a circle or squircle and drops the foreground's
    own shadow on it.

    Dark on purpose. Most launchers sit on pale wallpapers, and a light tile makes
    ORBIS disappear into the row next to every other white-background icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#FF10574E"
                    android:offset="0.0" />
                <item
                    android:color="#FF0A3B35"
                    android:offset="0.55" />
                <item
                    android:color="#FF062A26"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
