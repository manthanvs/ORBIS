<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orbis_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:layoutAnimation="@anim/layout_cards"
        android:orientation="vertical"
        android:padding="@dimen/screen_gutter">

        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_accent">

            <TextView
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/earn_balance_title" />

            <TextView
                android:id="@+id/balance_value"
                style="@style/OrbisHero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/balance_body"
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/focus_title"
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/earn_focus_title" />

            <TextView
                android:id="@+id/focus_body"
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/earn_focus_body" />

            <TextView
                android:id="@+id/focus_countdown"
                style="@style/OrbisHero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/focus_uses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/orbis_text_faint"
                android:textSize="13sp" />

            <Button
                android:id="@+id/focus_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/orbis_accent"
                android:text="@string/earn_focus_start"
                android:textColor="@color/orbis_accent_dark" />
        </LinearLayout>

        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/streak_title"
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/streak_body"
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
