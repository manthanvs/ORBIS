<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orbis_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:letterSpacing="0.2"
            android:text="@string/app_name"
            android:textColor="@color/orbis_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Setup, or the live status once everything is granted. -->
        <LinearLayout
            android:id="@+id/status_card"
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_accent">

            <TextView
                android:id="@+id/status_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:textColor="@color/orbis_accent"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status_title"
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/status_body"
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/status_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/orbis_accent"
                android:textColor="@color/orbis_accent_dark"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Time reclaimed, or "still learning" until there is history. -->
        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/reclaimed_title"
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_time_back_title" />

            <TextView
                android:id="@+id/reclaimed_value"
                style="@style/OrbisHero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/reclaimed_body"
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/streak_teaser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/orbis_warm"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- The 7-day trend. Bars are added in code, one per day. -->
        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_week_title" />

            <LinearLayout
                android:id="@+id/week_chart"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/week_caption"
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Level. -->
        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/level_title"
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/level_body"
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Where today went: one row per tracked app. -->
        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/home_where_title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/usage_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_how_title" />

            <TextView
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_how_body" />
        </LinearLayout>

        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_slowed_title" />

            <TextView
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_slowed_body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
