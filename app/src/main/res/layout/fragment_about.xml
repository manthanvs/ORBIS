<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orbis_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:layoutAnimation="@anim/layout_cards"
        android:orientation="vertical"
        android:padding="@dimen/screen_gutter">

        <TextView
            style="@style/OrbisTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/about_title"
            android:textSize="24sp" />

        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_accent">

            <TextView
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_short_title" />

            <TextView
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_short_body" />
        </LinearLayout>

        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_slowed_title" />

            <TextView
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_slowed_body" />
        </LinearLayout>

        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_whatsapp_title" />

            <TextView
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_whatsapp_body" />
        </LinearLayout>

        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_privacy_title" />

            <TextView
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_privacy_body" />
        </LinearLayout>

        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_how_title" />

            <TextView
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_how_body" />
        </LinearLayout>

        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_pace_title" />

            <TextView
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_pace_body" />
        </LinearLayout>

        <LinearLayout
            style="@style/OrbisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/OrbisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_limits_title" />

            <TextView
                style="@style/OrbisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_limits_body" />
        </LinearLayout>

        <TextView
            android:id="@+id/about_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/orbis_text_faint"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
